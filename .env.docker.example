# Copy to `.env` next to docker-compose.yml:  cp .env.docker.example .env
# Generate secrets with: openssl rand -hex 32

JWT_SECRET=
REDIS_PASSWORD=

# Public URL of the dashboard (used for CORS and OIDC redirect validation)
RAPI_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Host ports
RAPI_WEB_PORT=8080
RAPI_API_PORT=1337

# Set to `true` to expose /docs and /openapi.json
ENABLE_DOCS=false
LOG_FORMAT=json
RUST_LOG=info

# Optional SMTP (leave SMTP_HOST empty to use the local email outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
