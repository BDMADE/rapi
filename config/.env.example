# RAPI Server Configuration
RAPI_ENV=development
RAPI_HOST=0.0.0.0
RAPI_PORT=1337
RAPI_PUBLIC_URL=http://localhost:1337
ENABLE_DOCS=true

# SQLite Database (created automatically if missing)
DATABASE_URL=sqlite://data/rapi.db?mode=rwc

# Optional Redis URL — omit for zero-config single-binary mode (in-memory cache + SQLite queue)
# REDIS_URL=redis://:strong-redis-password@127.0.0.1:6379
# REDIS_PASSWORD=strong-redis-password

# Security (REQUIRED in production; must be >= 32 random bytes)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Storage & Logging
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_FORMAT=pretty
RUST_LOG=info,cms_api=debug,cms_db=info
