# RAPI Server Configuration
RAPI_HOST=0.0.0.0
RAPI_PORT=1337
RAPI_PUBLIC_URL=http://localhost:1337

# SQLite Database (created automatically if missing)
DATABASE_URL=sqlite://data/rapi.db?mode=rwc

# Optional Redis URL — omit for zero-config single-binary mode (in-memory cache + SQLite queue)
# REDIS_URL=redis://127.0.0.1:6379

# Security
JWT_SECRET=change-me-in-production-use-at-least-32-random-bytes

# Storage & Logging
UPLOAD_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_FORMAT=pretty
RUST_LOG=info,cms_api=debug,cms_db=info
